#!/usr/bin/env bash
# Hard 120s whole-hook timeout (fast-fail beats 59min orphan)
if [ -z "${PRE_PUSH_TIMEOUT_APPLIED:-}" ]; then
    export PRE_PUSH_TIMEOUT_APPLIED=1
    exec timeout --signal=KILL 120 "$0" "$@"
fi
# Fast pre-push: scripts/ci-fast.sh (changed files only). Full suite = CI job.
# Fast-only: full suite runs on GitHub CI.
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Skip on branch deletion
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && exit 0
done

# #500 D1: ruff + mypy on the changed files and the markdown check
exec bash scripts/ci-fast.sh
